# =========================================================
# CineMatch AI - Environment Configuration
# Copy this file to `.env` and fill in your API keys.
# NEVER commit your real `.env` file to version control.
# =========================================================

# Anthropic Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# TMDB API read access token (https://www.themoviedb.org/settings/api).
# Use the "API Read Access Token" (v4) — it is a JWT and is sent via the
# `Authorization: Bearer <token>` header. A classic v3 API key also works
# and is sent as the `api_key` query parameter.
TMDB_API_KEY=

# Optional: override model names
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional: TMDB image CDN base (for posters/trailers)
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# --- Voice assistant (Priya) ---
# Assistant name and whether voice mode is on by default.
VOICE_ASSISTANT_NAME=Priya
VOICE_ENABLED=true
# Female TTS voice (edge-tts); alternate used when primary is unavailable.
TTS_VOICE=en-IN-PriyaNeural
TTS_VOICE_ALT=en-US-JennyNeural
TTS_SPEED=1.0
# Speech-to-text language / engine ("google" = Google Web Speech, free).
STT_LANGUAGE=en-US
STT_GOOGLE_API=google
